# Optional. Every setting has a default, so no .env is needed to run the project.
# Copy to .env to override settings for `docker compose` (it reads .env automatically).
# Spring Boot itself does NOT read .env: for `./mvnw spring-boot:run`, export the values first
# (e.g. `set -a; source .env; set +a`).

# --- Local `./mvnw` runs only. Compose sets these itself (the app reaches the DB at postgres:5432). ---
DATABASE_URL=jdbc:postgresql://localhost:55433/orchestrator
PORT=8090

# Used by both. Postgres only applies the password when its volume is first created;
# after changing it, recreate the volume (`docker compose down -v`) or the app can't log in.
DATABASE_USER=orchestrator
DATABASE_PASSWORD=orchestrator
DB_POOL_SIZE=10

# Bounded executor size (tasks running at once in this JVM)
MAX_CONCURRENT_TASKS=4
# Retry backoff: base * 2^(attempt-1), capped at RETRY_MAX_MS  ->  2s, 4s, 8s ... 60s
RETRY_BASE_MS=2000
RETRY_MAX_MS=60000
# Scheduler loop interval
SCHEDULER_TICK_MS=200
# How often to recover tasks left 'running' with no live worker (e.g. outcome lost in a DB outage)
ORPHAN_SWEEP_MS=15000

# Empty = open demo mode. When set, POST endpoints (except /api/workflows/validate) require header X-API-Key.
API_KEY=
SEED_DEMO_DATA=true
