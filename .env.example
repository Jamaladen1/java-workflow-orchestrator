# Copy to .env and adjust. All settings are read from the environment.
DATABASE_URL=jdbc:postgresql://localhost:55433/orchestrator
DATABASE_USER=orchestrator
DATABASE_PASSWORD=orchestrator
PORT=8090

# Bounded executor size (tasks running at once in this JVM)
MAX_CONCURRENT_TASKS=4
# Retry backoff: base * 2^(attempt-1), capped at RETRY_MAX_MS  ->  2s, 4s, 8s ... 60s
RETRY_BASE_MS=2000
RETRY_MAX_MS=60000
# Scheduler loop interval
SCHEDULER_TICK_MS=200

# Empty = open demo mode. When set, POST endpoints require header X-API-Key.
API_KEY=
SEED_DEMO_DATA=true
